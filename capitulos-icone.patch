+// CAPITULOS DO ARQUIVO (capmkv.h): um botao na fileira, so quando o arquivo traz
+// capitulos, que abre a LISTA na ilha. CIMA/BAIXO escolhem, OK vai ao capitulo
+// (busca do dono: nao credita como assistido, como o CH+/CH-), Voltar fecha.
+#define CAPS_VIS 8
+static int capsAberto, capsSel, capsTopo, capsN;
+static MkvCap capsLista[MKV_MAX_CAPS];
+static int temCapitulos(void) {
+  MkvCap um[1];
+  return !ehCanal() && capmkv_lista(um, 1) > 0;
+}
+static void capsAjustar(void) {
+  if (capsSel > capsN - 1) capsSel = capsN - 1;
+  if (capsSel < 0) capsSel = 0;
+  if (capsSel < capsTopo) capsTopo = capsSel;
+  if (capsSel > capsTopo + CAPS_VIS - 1) capsTopo = capsSel - (CAPS_VIS - 1);
+  if (capsTopo < 0) capsTopo = 0;
+}
+// Abre ja no capitulo em que o filme esta.
+static void capsAbrir(void) {
+  int i;
+  capsN = capmkv_lista(capsLista, MKV_MAX_CAPS);
+  if (capsN < 1) return;
+  capsSel = 0; capsTopo = 0;
+  for (i = 0; i < capsN; i++) if (capsLista[i].inicio <= (double)posSeg + 0.5) capsSel = i;
+  capsAjustar();
+  capsAberto = 1;
+}
+static void corpoCaps(GfxRect r, float a, void *u) {
+  float x = r.x + 36.0f, w = r.w - 72.0f, y = r.y + 18.0f;
+  int vis = capsN < CAPS_VIS ? capsN : CAPS_VIS, i;
+  (void)u;
+  for (i = 0; i < vis; i++) {
+    int k = capsTopo + i, sel, tinta;
+    char nome[112], hora[24];
+    TxtLinha ln, lh;
+    if (k >= capsN) break;
+    sel = k == capsSel;
+    tinta = sel ? plrui_tinta() : 243;
+    if (capsLista[k].nome[0]) snprintf(nome, sizeof nome, "%s", capsLista[k].nome);
+    else snprintf(nome, sizeof nome, i18n("Cap\xc3\xadtulo %d"), k + 1);
+    plrui_tempo(hora, sizeof hora, capsLista[k].inicio);
+    if (sel) {
+      float ar, ag, ab;
+      corFocoPlayer(&ar, &ag, &ab);
+      gfx_cor((GfxRect){ x - 14.0f, y, w + 28.0f, 30.0f }, 0.5f, ar, ag, ab, 0.92f * a);
+    }
+    lh = txt_linha(TXT_ILHA_TEXTO, hora, tinta, tinta, tinta, sel ? 210 : 140);
+    ln = txt_linha_corta(TXT_ILHA_PERGUNTA, nome, tinta, tinta, tinta, 255, w - (float)lh.w - 24.0f);
+    txt_desenhar_alpha(ln, x, y + (30.0f - (float)ln.h) * 0.5f, a);
+    txt_desenhar_alpha(lh, x + w - (float)lh.w, y + (30.0f - (float)lh.h) * 0.5f, a);
+    y += 34.0f;
+  }
+}
