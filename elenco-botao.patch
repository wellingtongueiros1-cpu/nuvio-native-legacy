 // Fim da reproducao: zera o relogio e o painel. Sem isto o proximo filme
 // abriria com o cronometro do anterior ja meio andado.
 void pausao_fechar(void);
+// O botao "Elenco" do player: sobe a ficha JA, sem esperar os 4 s da pausa e mesmo com o
+// ajuste "Painel de pausa" desligado (nele o elenco tambem aparece, qualquer que seja o
+// ajuste do elenco). O player pausa antes; a ficha espera ate 2,5 s a pausa valer.
+void pausao_abrir_agora(void);
 // O item que o painel desenharia agora, ja conferido pelo titulo (-1 = nenhum).
 // Para teste (#190).
 int  pausao_indice(void);
