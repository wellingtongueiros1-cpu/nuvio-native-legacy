diff --git a/src/pausao.c b/src/pausao.c
index 8e574dd..0d7a186 100644
--- a/src/pausao.c
+++ b/src/pausao.c
@@ -68,6 +68,8 @@
 #define PAUSAO_COM_MS    6500u
 #define PAUSAO_COM_FADE   350.0f
 
+static Uint32 forcarAte;       // botao "Elenco": ate quando o pedido de subir ja vale
+static int    porBotao;        // a ficha subiu pelo botao: fica mesmo com o ajuste desligado
 static int    visivel;
 static float  anim;            // 0..1, a entrada por mola
 static Uint32 desdeQuando;     // quando a condicao passou a valer; 0 = nao vale
@@ -85,7 +87,13 @@ void pausao_activity(void) {
   desdeQuando = 0;
 }
 
+void pausao_abrir_agora(void) {
+  forcarAte = SDL_GetTicks() + 2500u;
+}
+
 void pausao_fechar(void) {
+  porBotao = 0;
+  forcarAte = 0;
   visivel = 0;
   anim = 0.0f;
   desdeQuando = 0;
@@ -122,16 +130,23 @@ void pausao_atualizar(float dt, Uint32 agora, int podeSubir, int idx,
 
   // O ajuste e consultado AQUI e nao na abertura: desligar a opcao com o painel
   // de pe tem de derrubar o painel, e nao valer so no filme seguinte.
-  if (!podeSubir || !ajustes_pausa_overlay()) {
+  int forcado = forcarAte && agora < forcarAte;
+  if (!forcado) forcarAte = 0;
+  if (!podeSubir || (!ajustes_pausa_overlay() && !porBotao && !forcado)) {
     // schedulePauseOverlay/syncPauseOverlayState (:7397): condicao que cai
     // derruba o painel e ZERA o relogio. Rearmar de onde parou faria uma
     // sequencia de pausas curtas somar quatro segundos e o painel subir sozinho
     // no meio de uma cena.
     visivel = 0;
     desdeQuando = 0;
+    porBotao = 0;
   } else {
     if (!desdeQuando) desdeQuando = agora;
-    if (!visivel && agora - desdeQuando >= PAUSAO_ESPERA_MS) {
+    if (forcado && !visivel) {
+      // Botao "Elenco": sobe agora. So valia depois de o player pausar (podeSubir).
+      visivel = 1; porBotao = 1; comT0 = agora; forcarAte = 0;
+      comProntos = pausacom_n() > 0;
+    } else if (!visivel && agora - desdeQuando >= PAUSAO_ESPERA_MS) {
       visivel = 1; comT0 = agora;
       // So entra no painel o que ja chegou: comentario tardio faria a ficha
       // inteira subir 140 px no meio da leitura.
@@ -158,8 +173,11 @@ int pausao_evento(const SDL_Event *e) {
   if (k == SDLK_ESCAPE || k == SDLK_AC_BACK || k == SDLK_BACKSPACE ||
       k == SDLK_DELETE) return PAUSAO_LIVRE;
 
+  // A tecla do botao que abriu a ficha pode repetir: so consome, nao fecha na cara.
+  if (e->key.repeat) return PAUSAO_CONSUMIU;
   visivel = 0;
   desdeQuando = 0;
+  porBotao = 0;
 
   // playerScreen.js:22212 — OK/Play com o painel de pe derruba o painel E
   // retoma. E o gesto obvio: quem esta olhando a ficha e aperta o centro quer
@@ -315,7 +333,7 @@ static void pausao_desenharCorpo_(Uint32 agora, const PausaoCena *cena) {
                            PAUSAO_LARG, PAUSAO_LD_SIN, 0.0f, PAUSAO_SIN_LINHAS);
     alt += 16.0f + hSin;
   }
-  temCast = c->nElenco > 0 && ajustes_pausa_elenco();
+  temCast = c->nElenco > 0 && (ajustes_pausa_elenco() || porBotao);
   nCom = comProntos ? pausacom_n() : 0;
   if (nCom > 0) alt += 16.0f + PAUSAO_COM_H;
   if (temCast) alt += 28.0f + 18.0f + 14.0f + PAUSAO_CARTA_H;
