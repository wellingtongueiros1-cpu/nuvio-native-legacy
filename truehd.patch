diff --git a/src/faixasmkv.c b/src/faixasmkv.c
index 45432f4..7ef8fa9 100644
--- a/src/faixasmkv.c
+++ b/src/faixasmkv.c
@@ -295,3 +295,31 @@ int faixasmkv_acrescentar_imagem(VideoFaixa *leg, int nLeg, int max, const MkvFa
 int faixasmkv_acrescentar_texto(VideoFaixa *leg, int nLeg, int max, const MkvFaixa *fx, int n) {
   return acrescentarOverlay(leg, nLeg, max, fx, n, 1);
 }
+
+static int audioOculto(const char *codec) {
+  const char *c = audioinfo_codec(codec);
+  return !strcmp(c, "TrueHD") || !strcmp(c, "MLP");
+}
+
+int faixasmkv_acrescentar_audio_oculto(VideoFaixa *aud, int nAud, int max, const MkvFaixa *fx, int n) {
+  int j, k, ord = 0, nA = 0, falta;
+  for (j = 0; fx && j < n; j++) if (fx[j].tipo == MKV_AUDIO) nA++;
+  falta = nA - nAud;
+  if (falta <= 0) return nAud;
+  // A TV lista alguma TrueHD (so nao toca): ela conhece a faixa, nada a recuperar.
+  for (k = 0; k < nAud; k++) if (audioOculto(aud[k].codec)) return nAud;
+  for (j = 0; j < n && nAud < max && falta > 0; j++) {
+    if (fx[j].tipo != MKV_AUDIO) continue;
+    ord++;
+    if (!audioOculto(fx[j].codec)) continue;
+    for (k = 0; k < nAud; k++) if (aud[k].numero < 0 && aud[k].ordinalMkv == ord - 1) break;
+    if (k < nAud) continue;
+    memset(&aud[nAud], 0, sizeof aud[nAud]);
+    aud[nAud].numero = -2 - (ord - 1);
+    aud[nAud].stream_index = aud[nAud].stream_id = -1;
+    aud[nAud].ordinalMkv = ord - 1;
+    aplicarUma(&aud[nAud], &fx[j], nAud + 1);
+    nAud++; falta--;
+  }
+  return nAud;
+}
