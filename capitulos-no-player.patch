   if (checa && g != ger) { pthread_mutex_unlock(&trava); return 0; }
   nomeado = a = n > 0 ? mkv_creditos_nomeados(caps, n) : 0.0;
   ultimo = b = n > 0 ? mkv_creditos_ultimo(caps, n) : 0.0;
+  nAtuais = n > 0 ? (n < MKV_MAX_CAPS ? n : MKV_MAX_CAPS) : 0;
+  if (nAtuais > 0) {
+    int i, j;
